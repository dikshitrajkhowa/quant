# Copy to .env (same folder) and fill in. .env is git-ignored - never commit your key.

# Megabull paper-trading API key: https://trade.megabull.in -> Profile -> generate API key.
# Keys expire after 1 month; paste the new one here and click "Reload API key" on the Trade page.
MEGABULL_API_KEY=

# Optional overrides
# MEGABULL_BASE_URL=https://api.megabull.in
# TRADE_SQUAREOFF_TIME=15:20          # intraday square-off (IST)
# TRADE_CANDLE_DELAY_SEC=20           # wait after a candle closes before fetching it
# TRADE_MAX_OPEN_POSITIONS=10
# TV_BROWSER=chrome                   # TradingView login via browser cookies (tvkit)
